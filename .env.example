NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The Clerk application this deployment signs people in with. The student
# site and the desk site are two deployments of this one codebase, each
# with its own Clerk application — a student account and a desk account are
# different accounts. Both applications are trusted by the one Supabase
# project (Authentication → Third-Party Auth, one entry per Clerk domain).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Never set NEXT_PUBLIC_CLERK_DOMAIN. Clerk's SDK reads it as an override for
# its Frontend API host, so a dev domain left in a production project sends
# every sign-in to the dev instance — which the strict CSP then blocks.

# Two sites on one deployment. Leave both empty and everything shares one host
# with the desk under /operator (how a bare localhost runs; desk.localhost:3000
# shows the desk site there too). Set them and the middleware serves the desk
# on its host, the student site on the other, and sends stray pages across.
NEXT_PUBLIC_DESK_HOST=
NEXT_PUBLIC_SITE_HOST=
# Pin a deployment to one site regardless of host — "desk" on the desk
# deployment, so its preview URLs are the desk too. Leave empty locally.
NEXT_PUBLIC_SURFACE=

# The contact address printed on /privacy and /terms. Leave empty and the
# pages say to ask at the desk instead — nothing invented.
NEXT_PUBLIC_SUPPORT_EMAIL=
# WhatsApp support, digits only with the country code (e.g. 919876543210). Shown on the desk site and the legal pages when set.
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Paying through Printifi (optional): Cashfree Payment Gateway with Easy
# Split. The secret stays on the server; the browser only learns which
# SDK mode to load. Leave all four empty and nothing is offered — the
# direct-to-desk UPI flows stand alone. Webhook URL in the Cashfree
# dashboard: https://<site>/api/payments/webhook (PAYMENT_SUCCESS_WEBHOOK).
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
NEXT_PUBLIC_CASHFREE_MODE=

# WhatsApp notifications (optional). Without these, messages queue but report
# "not configured" instead of pretending to send.
SUPABASE_SERVICE_ROLE_KEY=
# The maintenance routes accept this as `x-notify-secret` or as
# `Authorization: Bearer …`. Vercel Cron sends the latter from CRON_SECRET;
# set CRON_SECRET to the same value (or leave it unset and set only this).
NOTIFY_WEBHOOK_SECRET=
CRON_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_DEFAULT_COUNTRY=91

# Office files → PDF (0041). A Gotenberg instance you host (LibreOffice behind an
# HTTP API — Vercel can't run LibreOffice itself). Server-side only; the browser
# never sees it. CONVERT_USER/PASSWORD match GOTENBERG_API_BASIC_AUTH_USERNAME/
# PASSWORD on that instance. Set NEXT_PUBLIC_CONVERTS_OFFICE=1 on the same
# deployment so the upload sheet takes Word, PowerPoint, Excel and text files;
# without it they're turned away with "save as PDF first".
CONVERT_URL=
CONVERT_USER=
CONVERT_PASSWORD=
NEXT_PUBLIC_CONVERTS_OFFICE=
